# Copy to .env. All keys map to sde_curation/config.py (case-insensitive).
# The AWS deployment (infra/, CDK) sets every value below itself; this file is for running locally.
DATA_DIR=./data                 # collections/<id>/*.yaml, index logs, scrape jobs
# PostgreSQL (`make db-up` starts this one in Docker). In ECS the stack sets DB_HOST/DB_PORT/DB_NAME
# and injects DB_USER/DB_PASSWORD from the RDS secret instead of one URL.
DATABASE_URL=postgresql://engine:engine@localhost:5432/engine
#DB_POOL_SIZE=8                 # connections per engine process
CRAWLER_ROOT=../sde-crawl4ai-scraper
INDEXER_ROOT=../sde-api-scrapers
SCRAPE_BACKEND=local            # local | ssm
INDEX_BACKEND=local             # local | ecs
AWS_REGION=us-east-1
AWS_PROFILE=                    # local runs only: named AWS CLI/SSO profile for boto3 (unset in ECS)
CRAWLER_S3_BUCKET=
CRAWLER_S3_PREFIX=              # folder inside the bucket ("" = root): <prefix>/scraped_collections/…
CRAWLER_INSTANCE_ID=
COSMOS_INDEX_BUCKET=sde-cosmos-indexing-dev
WEB_INDEX_NAME=sde-web-subset          # indexer's working index; live sde-web only at cutover
TEST_FRONTEND_URL=http://d2vsr84ys2zd7q.cloudfront.net/   # "Open test front end" button on step 5
PROD_FRONTEND_URL=https://science.data.nasa.gov/science-discovery-engine/search/sde/home   # "Open prod front end" button on step 6
# ecs backend (task definition carries the OpenSearch/SageMaker env):
INDEXING_ECS_CLUSTER=api-scrapers-cluster-dev
INDEXING_TASK_FAMILY=web_cosmos-scraper-dev
INDEXING_DISPATCH_ROLE_ARN=            # optional; falls back to ambient credentials
INDEXING_SUBNETS=["subnet-..."]         # required for ecs (Fargate awsvpc)
INDEXING_SECURITY_GROUPS=[]
# local backend (runs api_scraper.py in INDEXER_ROOT's venv) needs these too:
OPENSEARCH_ENDPOINT_TEST=
OPENSEARCH_ENDPOINT_PROD=       # Index to prod publishes the test run's vectors here (engine writes directly)
PROD_INDEX_ROLE_ARN=            # role in the prod account with AOSS write on sde-web (unset = ambient credentials)
#PUBLISH_BULK_DOCS=100
#PUBLISH_DELETION_ABORT_RATIO=0.90   # refuse a prod publish that would tombstone more than this share…
#PUBLISH_DELETION_ABORT_MAX=5000     # …or more than this many documents
SAGEMAKER_ENDPOINT_NAME=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna      # 1.05M-token window; Suggest metadata sends the full page text, never cut
#LLM_WORKERS=16                # concurrent calls inside one LLM job
#LLM_RETRY_PASSES=1            # re-run calls that hit rate limits / 5xx / timeouts at the end of a job
#LLM_RETRY_DELAY_S=30          # wait before that retry pass (it runs with a quarter of the workers)
#LLM_TEMPERATURE=              # unset = model default; gpt-5 / o-series reject anything else
#LLM_MAX_RETRIES=5             # client retries on 429 / 5xx / timeouts
#LLM_PATTERN_BATCH_URLS=1000   # URLs (+ titles) per Suggest-patterns call
#LLM_DEDUPE_TITLES=false       # true: Suggest metadata re-titles same title + doc type pages by itself (default: flag only)
#PROMOTE_REMOVAL_WARN_RATIO=0.25 # warn before promoting when this share of the curated set vanished from the crawl
#GLOBAL_EXCLUDES_PATH=         # override sde_curation/data/global_excludes.yaml
VALIDATION_DELAY_S=30
#VALIDATION_POLL_INTERVAL_S=15   # re-check the index this often while it is still short
#VALIDATION_TIMEOUT_S=600        # give OpenSearch this long to become consistent before failing the gate
VALIDATION_ASSUME_ROLE_ARN=            # optional: role with AOSS data access for direct validation
NOTIFY_WEBHOOK_URL=
PUBLIC_BASE_URL=http://localhost:8080
# access control — leave APP_PASSWORD empty locally (it switches login on and seeds the bootstrap 'admin' account)
APP_PASSWORD=
SESSION_SECRET=
AUTH_COOKIE_SECURE=false
